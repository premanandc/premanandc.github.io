---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TalkCard from '../components/TalkCard.astro';
import PulseBar from '../components/PulseBar.astro';
import { talks } from '../data/talks';
import { now } from '../data/now';
import { getReadingTime } from '../utils/reading-time';
import { getLastCommitDate } from '../utils/github';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft && !data.unlisted))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const HOME_LIMIT = 4;
const posts = allPosts.slice(0, HOME_LIMIT);
const latestPost = allPosts[0];

const publicTalks = talks.filter(t => !t.unlisted);
const recentTalks = publicTalks.slice(0, HOME_LIMIT);

const lastCommitDate = await getLastCommitDate('premanandc');
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-text">
      <h1>Engineering leader who writes about what actually works.</h1>
      <p>I build software, lead teams, and write about the gap between what technologies promise and what they deliver.</p>
    </div>
    <img src="/images/headshot.png" class="hero-image" alt="Prem Chandrasekaran" />
  </section>

  <PulseBar
    lastPostTitle={latestPost?.data.title}
    lastPostSlug={latestPost?.id}
    lastPostDate={latestPost?.data.date}
    lastCommitDate={lastCommitDate}
    nowUpdated={now.lastUpdated}
  />

  <h2 class="section-title">Latest Writing</h2>
  <div>
    {posts.map(post => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        excerpt={post.data.excerpt}
        tags={post.data.tags}
        slug={post.id}
        readingTime={getReadingTime(post.body ?? '')}
        coverImage={post.data.coverImage}
      />
    ))}
  </div>
  {allPosts.length > posts.length && (
    <a href="/blog" class="section-more">View all articles &rarr;</a>
  )}

  <h2 class="section-title">Recent Talks</h2>
  <div>
    {recentTalks.map(talk => <TalkCard {...talk} />)}
  </div>
  {publicTalks.length > recentTalks.length && (
    <a href="/talks" class="section-more">View all talks &rarr;</a>
  )}

</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 56px 0 48px;
  }

  .hero-text {
    flex: 1;
  }

  .hero-text h1 {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .hero-text p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 540px;
  }

  .hero-image {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid var(--border);
  }

  .section-title {
    margin: 40px 0 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-secondary);
  }

  .section-more {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 500;
  }

  /* Narrow screens: photo above the intro text */
  @media (max-width: 640px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 24px;
      padding: 32px 0;
    }

    .hero-image {
      width: 96px;
      height: 96px;
    }
  }
</style>
