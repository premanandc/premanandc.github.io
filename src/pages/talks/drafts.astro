---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkCard from '../../components/TalkCard.astro';
import { talks } from '../../data/talks';

const drafts = talks.filter(t => t.unlisted);
---

<BaseLayout
  title="Talk Drafts"
  description="Unlisted talks available for review."
  noindex={true}
>
  <div class="talks-header">
    <h1>Talk Drafts</h1>
    <p>Unlisted talks. Reachable by direct URL but hidden from the public site.</p>
  </div>
  <div>
    {drafts.length === 0 && (
      <p class="talks-empty">No unlisted talks.</p>
    )}
    {drafts.map(talk => <TalkCard {...talk} />)}
  </div>
</BaseLayout>

<style>
  .talks-header {
    padding: 40px 0 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }

  .talks-header h1 {
    margin-bottom: 8px;
  }

  .talks-header p {
    color: var(--text-secondary);
    font-size: 16px;
  }

  .talks-empty {
    padding: 40px 0;
    color: var(--text-secondary);
    font-size: 15px;
    grid-column: 1 / -1;
  }
</style>
