---
import type { Talk } from '../data/talks';

type Props = Talk;

const { title, event, date, description, tags, url, eventUrl, videoUrl, coverImage } = Astro.props;
---

<article class="entry" data-tags={tags.join('|')}>
  {coverImage && <img src={coverImage} alt="" class="entry-cover" />}
  <div class="entry-body">
    <div class="entry-meta">
      <span>{date}</span>
      <span class="entry-meta-dot">&bull;</span>
      {eventUrl ? (
        <a href={eventUrl} target="_blank" rel="noopener noreferrer">{event}</a>
      ) : (
        <span>{event}</span>
      )}
    </div>
    <h3><a href={url} class="entry-link">{title}</a></h3>
    <p>{description}</p>
    <div class="entry-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
    {videoUrl && (
      <div class="entry-actions">
        <a href={videoUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">&#9654;</span> Watch the talk</a>
      </div>
    )}
  </div>
</article>
