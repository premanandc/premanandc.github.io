---
interface Props {
  title: string;
  date: Date;
  excerpt: string;
  tags: string[];
  slug: string;
  readingTime: string;
  coverImage?: string;
}

const { title, date, excerpt, tags, slug, readingTime, coverImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<a href={`/blog/${slug}`} class="entry" data-tags={tags.join('|')}>
  {coverImage && <img src={coverImage} alt="" class="entry-cover" />}
  <div class="entry-body">
    <div class="entry-meta">
      <span>{formattedDate}</span>
      <span class="entry-meta-dot">&bull;</span>
      <span>{readingTime}</span>
    </div>
    <h3>{title}</h3>
    <p>{excerpt}</p>
    <div class="entry-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>
