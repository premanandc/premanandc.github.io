---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description = 'Prem Chandrasekaran — engineering leader, writer, speaker.', ogImage, ogType = 'website', noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | premonition.dev`;
const socialImage = ogImage ? new URL(ogImage, Astro.site).href : new URL('/images/headshot.png', Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'premonition.dev',
  'url': 'https://premonition.dev',
  'author': {
    '@type': 'Person',
    'name': 'Prem Chandrasekaran',
    'url': 'https://premonition.dev/about',
    'sameAs': [
      'https://x.com/premanandc',
      'https://github.com/premanandc',
      'https://linkedin.com/in/premanandc',
    ],
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="premonition.dev" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="premonition.dev" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@premanandc" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script defer src="https://cloud.umami.is/script.js" data-website-id="349f2408-20f1-4b34-b93b-3491e9fe0467"></script>
    <JsonLd data={websiteSchema} />
    <slot name="json-ld" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }
</style>
