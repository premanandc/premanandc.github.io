---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import TableOfContents from '../components/blog/TableOfContents.tsx';
import Lightbox from '../components/blog/Lightbox.tsx';
import SeriesNav from '../components/blog/SeriesNav.astro';

interface SeriesInfo {
  name: string;
  part: number;
  total: number;
}

interface SeriesPart {
  title: string;
  slug: string;
}

interface Props {
  title: string;
  date: Date;
  tags: string[];
  readingTime: string;
  coverImage?: string;
  excerpt?: string;
  series?: SeriesInfo;
  seriesParts?: SeriesPart[];
  unlisted?: boolean;
}

const { title, date, tags, readingTime, coverImage, excerpt, series, seriesParts, unlisted = false } = Astro.props;

const slug = Astro.url.pathname.replace('/blog/', '').replace(/\/$/, '');
const ogImage = coverImage ?? `/og/${slug}.png`;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': excerpt,
  'datePublished': date.toISOString(),
  'author': {
    '@type': 'Person',
    'name': 'Prem Chandrasekaran',
    'url': 'https://premonition.dev/about',
  },
  ...(coverImage && { 'image': new URL(coverImage, 'https://premonition.dev').href }),
  'publisher': {
    '@type': 'Person',
    'name': 'Prem Chandrasekaran',
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, 'https://premonition.dev').href,
  },
};
---

<BaseLayout title={title} description={excerpt} ogImage={ogImage} ogType="article" noindex={unlisted}>
  <JsonLd data={articleSchema} slot="json-ld" />
  <article>
    {unlisted && (
      <aside class="unlisted-banner" role="status" aria-label="Draft notice">
        <span class="unlisted-banner-dot" aria-hidden="true"></span>
        <span class="unlisted-banner-text">
          <strong>Draft.</strong> This post is unlisted and intended for review. Please don't share publicly.
        </span>
      </aside>
    )}
    <header class="article-header">
      <div class="article-tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1>{title}</h1>
      <div class="article-meta">
        <img src="/images/headshot.png" alt="Prem Chandrasekaran" class="meta-avatar" />
        <span>Prem Chandrasekaran</span>
        <span class="meta-dot">&bull;</span>
        <span>{formattedDate}</span>
        <span class="meta-dot">&bull;</span>
        <span>{readingTime}</span>
      </div>
    </header>
    {coverImage && (
      <img src={coverImage} alt={title} class="cover-image" />
    )}
    {series && seriesParts && (
      <SeriesNav
        seriesName={series.name}
        currentPart={series.part}
        total={series.total}
        parts={seriesParts}
      />
    )}
    <div class="article-with-toc">
      <div class="article-body">
        <slot />
      </div>
      <aside class="toc-sidebar">
        <TableOfContents client:load />
      </aside>
    </div>
  </article>
  <Lightbox client:load />
</BaseLayout>

<style>
  article {
    padding-top: 40px;
    max-width: 1000px;
  }

  @media (min-width: 1200px) {
    article {
      max-width: 1000px;
    }
  }

  .unlisted-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    margin-bottom: 28px;
    background: var(--callout-warning-bg);
    border-left: 3px solid var(--callout-warning-border);
    border-radius: 0 8px 8px 0;
    max-width: 680px;
  }

  .unlisted-banner-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--callout-warning-border);
    box-shadow: 0 0 0 4px var(--callout-warning-bg);
  }

  .unlisted-banner-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .unlisted-banner-text strong {
    color: var(--callout-warning-border);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .article-header {
    margin-bottom: 32px;
  }

  .article-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--tag-bg);
    color: var(--accent);
    border: 1px solid var(--tag-border);
  }

  h1 {
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .meta-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .meta-dot {
    color: var(--border);
  }

  .cover-image {
    width: 100%;
    max-width: 680px;
    border-radius: 10px;
    margin-bottom: 32px;
  }

  .article-with-toc {
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }

  .article-body {
    max-width: 680px;
    min-width: 0;
    flex: 1;
  }

  .toc-sidebar {
    position: sticky;
    top: 24px;
    width: 220px;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 1200px) {
    .toc-sidebar {
      display: block;
    }
  }

  .article-body :global(p) {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 20px;
    color: #292524;
  }

  .article-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.25rem;
    font-size: 17px;
    line-height: 1.8;
    color: #292524;
  }

  .article-body :global(li) {
    margin-bottom: 0.25rem;
  }

  .article-body :global(strong) {
    font-weight: 700;
  }
</style>
